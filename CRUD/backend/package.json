{
  "name": "lifehub-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "db:init": "node --env-file=.env --import tsx src/db/init.ts",
    "db:demo": "node --env-file=.env --import tsx src/auth/seed.ts",
    "test": "node --env-file=.env --import tsx --test test/products.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
